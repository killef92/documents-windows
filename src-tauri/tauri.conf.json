{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Documents",
  "version": "0.1.0",
  "identifier": "fr.marouteau.apercu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Documents",
        "width": 1280,
        "height": 860,
        "minWidth": 708,
        "minHeight": 224,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: page: vignette: http://page.localhost http://vignette.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: page: vignette: http://page.localhost http://vignette.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kilian Lefèvre",
    "shortDescription": "PDF and image viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "French",
          "Spanish",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "SimpChinese",
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "icons/types/pdf.ico": "types/pdf.ico",
      "icons/types/jpg.ico": "types/jpg.ico",
      "icons/types/png.ico": "types/png.ico",
      "icons/types/webp.ico": "types/webp.ico",
      "icons/types/gif.ico": "types/gif.ico",
      "icons/types/image.ico": "types/image.ico",
      "icons/types/heic.ico": "types/heic.ico",
      "icons/types/tif.ico": "types/tif.ico",
      "icons/types/bmp.ico": "types/bmp.ico",
      "icons/types/raw.ico": "types/raw.ico",
      "icons/types/ai.ico": "types/ai.ico",
      "icons/types/jp2.ico": "types/jp2.ico",
      "icons/types/hdr.ico": "types/hdr.ico",
      "icons/types/exr.ico": "types/exr.ico",
      "icons/types/ico.ico": "types/ico.ico",
      "icons/types/ppm.ico": "types/ppm.ico"
    },
    "copyright": "© 2026 Kilian Lefèvre — MIT. Third-party licenses: THIRD-PARTY-LICENSES.txt",
    "license": "MIT",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Document PDF",
        "description": "Document PDF",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "Image JPEG",
        "description": "Image JPEG",
        "role": "Viewer",
        "mimeType": "image/jpeg"
      },
      {
        "ext": [
          "png"
        ],
        "name": "Image PNG",
        "description": "Image PNG",
        "role": "Viewer",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "Image WebP",
        "description": "Image WebP",
        "role": "Viewer",
        "mimeType": "image/webp"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "Image GIF",
        "description": "Image GIF",
        "role": "Viewer",
        "mimeType": "image/gif"
      },
      {
        "ext": [
          "heic",
          "heif"
        ],
        "name": "Image HEIC",
        "description": "Image HEIC",
        "role": "Viewer",
        "mimeType": "image/heic"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "Image TIFF",
        "description": "Image TIFF",
        "role": "Viewer",
        "mimeType": "image/tiff"
      },
      {
        "ext": [
          "bmp",
          "dib"
        ],
        "name": "Image BMP",
        "description": "Image BMP",
        "role": "Viewer",
        "mimeType": "image/bmp"
      },
      {
        "ext": [
          "cr2",
          "dng"
        ],
        "name": "Photo RAW",
        "description": "Photo RAW",
        "role": "Viewer"
      },
      {
        "ext": [
          "ai"
        ],
        "name": "Dessin AI",
        "description": "Dessin vectoriel AI",
        "role": "Viewer",
        "mimeType": "application/postscript"
      },
      {
        "ext": [
          "jp2",
          "j2k",
          "j2c",
          "jpf",
          "jpx"
        ],
        "name": "Image JPEG 2000",
        "description": "Image JPEG 2000",
        "role": "Viewer",
        "mimeType": "image/jp2"
      },
      {
        "ext": [
          "hdr"
        ],
        "name": "Image HDR",
        "description": "Image HDR",
        "role": "Viewer"
      },
      {
        "ext": [
          "exr"
        ],
        "name": "Image OpenEXR",
        "description": "Image OpenEXR",
        "role": "Viewer"
      },
      {
        "ext": [
          "ico"
        ],
        "name": "Image ICO",
        "description": "Icone",
        "role": "Viewer",
        "mimeType": "image/x-icon"
      },
      {
        "ext": [
          "ppm",
          "pgm",
          "pbm",
          "pnm",
          "pam"
        ],
        "name": "Image PPM",
        "description": "Image PPM",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RDA1NjczODc4RkE0QjQKUldTMHBJK0hjMWJRMWR6aFZsSk0wRGkzUVNhWXQxVzdldTcvNnhsTGpjZ2NCWGJ2TEN4emJkZ2sK",
      "endpoints": [
        "https://raw.githubusercontent.com/killef92/documents-windows/versions/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
